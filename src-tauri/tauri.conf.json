{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CRM",
  "version": "0.1.0",
  "identifier": "sk.crm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CRM",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Kristián Kačinetz",
    "copyright": "© 2026 Kristián Kačinetz. Všetky práva vyhradené.",
    "category": "Business",
    "shortDescription": "Interné CRM pre konateľa firmy",
    "longDescription": "Lokálna desktopová aplikácia na evidenciu zákazníkov, faktúr a ich stavov, cenových ponúk s PDF, obchodnej pipeline a zákaziek. Autor: Kristián Kačinetz.",
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Slovak",
          "English"
        ]
      },
      "wix": {
        "language": "sk-SK"
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:crm.db"
      ]
    }
  }
}
